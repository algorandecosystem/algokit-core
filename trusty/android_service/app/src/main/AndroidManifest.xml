<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No special <uses-permission> exists for "talk to a Trusty TA": access
      to /dev/trusty-ipc-dev0 is gated by plain Unix DAC permissions and
      SELinux, not the Android permission model. See TipcClient's doc
      comment for how to unblock that on a userdebug/eng Cuttlefish build.
    -->

    <!-- Only for submitting signed test transactions to algod (AlgodClient). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      usesCleartextTraffic: lets a debug build reach a plain-HTTP algod
      (e.g. an AlgoKit LocalNet on the host). Remove for anything real.
    -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.SeedVaultCompanion"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
